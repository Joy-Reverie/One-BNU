<?xml version="1.0" encoding="utf-8"?>
<!-- 小组件顶部色带：与首页 Hero 卡同一组渐变；上两角圆角与卡片一致，下边与卡身相接 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="@color/widget_hero_start"
        android:centerColor="@color/widget_hero_center"
        android:endColor="@color/widget_hero_end"
        android:type="linear" />
    <corners
        android:topLeftRadius="@dimen/widget_corner"
        android:topRightRadius="@dimen/widget_corner" />
</shape>
